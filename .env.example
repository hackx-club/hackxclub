# Domain & Reverse Proxy (Caddy Auto-SSL)
DOMAIN="hackx.club"
ACME_EMAIL="admin@hackx.club"

# Local PostgreSQL Configuration (Docker Compose)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your-secure-postgres-password"
POSTGRES_DB="hackxclub"
DATABASE_URL="postgresql://postgres:your-secure-postgres-password@postgres:5432/hackxclub"

# Supabase Configuration
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_URL="https://your-project-id.supabase.co"

# Client-side exposed Supabase Configuration
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Database Direct Connection URL for Migrations (Drizzle)
# Direct IPv6 host: postgresql://postgres:[PASSWORD]@db.your-project-id.supabase.co:5432/postgres
# IPv4 Pooler host: postgresql://postgres.your-project-id:[PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?sslmode=require
LOVABLE_DB_MIGRATION_URL="postgresql://postgres:[PASSWORD]@db.your-project-id.supabase.co:5432/postgres"

# Supabase Service Role Key (Used server-side by Admin Portal to bypass Row Level Security over HTTPS)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=""

# Automated Registration Emails (SMTP / Gmail)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="clubhackx@gmail.com"
SMTP_PASS="your-google-app-password"
EMAIL_FROM="HackX Club <clubhackx@gmail.com>"
