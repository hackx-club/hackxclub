{
    # Global options: Email for Let's Encrypt / ZeroSSL expiry notifications
    email {$ACME_EMAIL:admin@hackx.club}
}

# Domain configured via environment variable (default: localhost for local testing)
{$DOMAIN:localhost} {
    # Reverse proxy to the TanStack Start app container
    reverse_proxy app:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Enable modern compression algorithms
    encode zstd gzip

    # Essential security headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
}
